{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AppBox",
  "version": "0.1.2",
  "identifier": "io.qingtian.appbox",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AppBox",
        "width": 1280,
        "height": 832,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/weqtian/AppBox/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCNzFCMkIwNzk1OUVFOUEKUldTYTdsbDVzTEp4SzZZbEpiVTJZUTk2NTBHM1dsTDNmbWFHT0p1SHB4RXpDTmhxY3E5SmFWYkYK"
    }
  }
}
